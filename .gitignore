# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archives & backups
*.zip
*.rar
*.7z
*.tar.gz

# temporary scripts and artifacts
/scratch/
/archive/

/src/generated/prisma
*.db
*.db-journal
*.sqlite
*.sqlite3

# Docker runtime verisi — canlı DB/redis/n8n dosyaları GİT'E GİRMEMELİ
# (PII + şifre hash'leri içerir; ayrıca repo'yu şişirir). Yalnız compose/config izlenir.
/docker/data/

# Playwright MCP test artefaktları (ölçüm çıktıları — çöp)
/.playwright-mcp/

# Blog taslakları — generate-blog-draft.ts çıktısı, geçici
/src/data/drafts/

# PWA build artifact'ları (next-pwa tarafından üretilir, runtime'da regenerate olur)
/public/sw.js
/public/workbox-*.js
/public/swe-worker-*.js
/public/fallback-*.js

# Geçici patch scriptleri
/patch_*.js

# Dumps, logs & database backups
*.sql
*.dump
*.rdb
*.log
*.bak
*.key
*.crt
*.pfx
