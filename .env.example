# Alo Yönetim — Ortam Değişkenleri (Şablon)
# Gerçek değerleri .env dosyasına kopyalayın. Tanımlı değilse ilgili
# script/etiket render EDİLMEZ (mock değerler yayına çıkmaz).

# ─────────────────────────────────────────────────────────────
# DATABASE & CACHE
# ─────────────────────────────────────────────────────────────

# Veritabanı Parolası (Docker Compose için)
POSTGRES_PASSWORD=alo_password_123!

# PostgreSQL bağlantı adresi (Prisma ve Next.js için)
DATABASE_URL="postgresql://alo_user:${POSTGRES_PASSWORD}@localhost:5432/aloyonetim?schema=public"

# Redis Parolası (Docker Compose için)
REDIS_PASSWORD=alo_redis_local_dev_2026

# Redis bağlantı adresi (Önbellekleme için)
REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6379"

# ─────────────────────────────────────────────────────────────
# SECURITY & AUTH
# ─────────────────────────────────────────────────────────────

# JWT Gizli Anahtarı (Admin paneli vs.)
JWT_SECRET="lutfen_canli_ortamda_guclu_bir_sifre_belirleyin_2026"

# ─────────────────────────────────────────────────────────────
# ANALYTICS & SEO
# ─────────────────────────────────────────────────────────────

# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity proje kimliği
NEXT_PUBLIC_CLARITY_ID=

# Meta (Facebook) Pixel kimliği — reklam retargeting
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Search Console site doğrulama kodu (meta google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster site doğrulama kodu (meta msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow anahtarı (Bing/Yandex anlık indeksleme). public/<key>.txt ile eşleşmeli.
INDEXNOW_KEY=

# ─────────────────────────────────────────────────────────────
# LEAD YAKALAMA (API & Webhooks)
# ─────────────────────────────────────────────────────────────

# E-posta bildirimi — Resend (https://resend.com). API anahtarı + hedef adres.
RESEND_API_KEY=
LEAD_TO_EMAIL=istanbul@aloyonetim.com.tr
LEAD_FROM_EMAIL="Alo Yönetim <bildirim@aloyonetim.com.tr>"

# Telegram bildirimi — @BotFather'dan bot token'ı, hedef sohbet/grup chat_id'si.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Veritabanı kaydı — Supabase (REST). Proje URL'i + service_role anahtarı.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# N8N Webhook URL'si
N8N_WEBHOOK_URL="http://localhost:5678/webhook/yeni-talep"

# WhatsApp tıkla-konuş butonu (CRO) — uluslararası format, + ve boşluksuz. Örn: 905505504848
NEXT_PUBLIC_WHATSAPP_NUMBER=