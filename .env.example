# Alo Yönetim — Ortam Değişkenleri (örnek)
# Gerçek değerleri .env.local dosyasına kopyalayın. Tanımlı değilse ilgili
# script/etiket render EDİLMEZ (mock değerler yayına çıkmaz — SEO V4 Faz 10).

# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity proje kimliği
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console site doğrulama kodu (meta google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=
