# Alo Yönetim — Ortam Değişkenleri (örnek)
# Gerçek değerleri .env.local dosyasına kopyalayın. Tanımlı değilse ilgili
# script/etiket render EDİLMEZ (mock değerler yayına çıkmaz — SEO V4 Faz 10).

# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity proje kimliği
NEXT_PUBLIC_CLARITY_ID=

# Meta (Facebook) Pixel kimliği — reklam retargeting (opsiyonel; tanımlıysa yüklenir)
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Search Console site doğrulama kodu (meta google-site-verification)
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster site doğrulama kodu (meta msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow anahtarı (Bing/Yandex anlık indeksleme — Faz 29). public/<key>.txt ile eşleşmeli.
INDEXNOW_KEY=

# ─────────────────────────────────────────────────────────────
# LEAD YAKALAMA (Fonksiyonel Katman Track 1) — /api/lead kanalları.
# Her kanal env-gated: tanımlı değilse sessizce atlanır (akış çökmez).
# Kurulum ayrıntıları: LEADS_SETUP.md
# ─────────────────────────────────────────────────────────────

# E-posta bildirimi — Resend (https://resend.com). API anahtarı + hedef adres.
RESEND_API_KEY=
LEAD_TO_EMAIL=istanbul@aloyonetim.com
# Gönderen (doğrulanmış domain gerekir; yoksa Resend test adresi kullanılır)
LEAD_FROM_EMAIL=Alo Yönetim <bildirim@aloyonetim.com>

# Telegram bildirimi — @BotFather'dan bot token'ı, hedef sohbet/grup chat_id'si.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Veritabanı kaydı — Supabase (REST). Proje URL'i + service_role anahtarı (SUNUCU-ONLY!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp tıkla-konuş butonu (CRO) — uluslararası format, + ve boşluksuz. Örn: 905505504848
NEXT_PUBLIC_WHATSAPP_NUMBER=
