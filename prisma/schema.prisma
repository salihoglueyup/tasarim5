// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  name_en        String?
  name_ru        String?
  name_ar        String?
  description    String
  description_en String?
  description_ru String?
  description_ar String?
  parentId       String?
  parent         Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children       Category[] @relation("SubCategories")
  posts          Post[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  avatar    String?
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  title_en       String?
  title_ru       String?
  title_ar       String?
  description    String
  description_en String?
  description_ru String?
  description_ar String?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  tags           String // Comma-separated string or JSON string
  authorId       String
  author         Author   @relation(fields: [authorId], references: [id])
  image          String?
  pillar         String?
  tldr           String?
  tldr_en        String?
  tldr_ru        String?
  tldr_ar        String?
  content        String // Storing JSON stringified blocks or HTML
  content_en     String?
  content_ru     String?
  content_ar     String?
  published      Boolean  @default(false)
  datePublished  DateTime @default(now())
  dateModified   DateTime @updatedAt

  @@index([published, datePublished(sort: Desc)])
  @@index([categoryId, published])
  @@index([authorId, published])
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  question_en String?
  question_ru String?
  question_ar String?
  answer      String
  answer_en   String?
  answer_ru   String?
  answer_ar   String?
  category    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, order])
}

model Reference {
  id          String  @id @default(cuid())
  title       String
  title_en    String?
  title_ru    String?
  title_ar    String?
  slug        String  @unique
  category    String
  location    String
  location_en String?
  location_ru String?
  location_ar String?
  units       String
  image       String?
  published   Boolean @default(true)
  order       Int     @default(0)

  // Detay Sayfası Ek Alanları
  content            String? // Uzun proje açıklaması
  content_en         String?
  content_ru         String?
  content_ar         String?
  services           String? // Virgülle ayrılmış hizmetler (örn: 7/24 Güvenlik, Havuz Bakımı)
  services_en        String?
  services_ru        String?
  services_ar        String?
  gallery            String? // JSON formatında çoklu resim URL'leri
  testimonialText    String? // Müşteri yorumu
  testimonialText_en String?
  testimonialText_ru String?
  testimonialText_ar String?
  testimonialAuthor  String? // Yorumu yapan kişi
  stats              String? // JSON formatında istatistikler [{"label":"Aidat Tahsilatı", "value":"%98"}]
  coordinates        String? // Harita koordinatları "lat,lng"

  isSuccessStory Boolean @default(false) // Başarı Hikayesi sayfasında gösterilecek mi?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([category, published])
  @@index([isSuccessStory, published])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  type      String // 'contact' | 'callback' | 'quote' | 'newsletter'
  name      String?
  phone     String?
  email     String?
  subject   String?
  message   String?
  meta      String? // JSON string
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([isRead, createdAt(sort: Desc)])
}

model CalculatorConfig {
  id              String   @id @default(cuid())
  baseCostPerUnit Int      @default(350)
  securityAddon   Int      @default(450)
  poolAddon       Int      @default(180)
  greenAddon      Int      @default(120)
  elevatorAddon   Int      @default(40)
  savingsRate     Float    @default(0.22)
  updatedAt       DateTime @updatedAt
}

model CalculatorLog {
  id            String   @id @default(cuid())
  units         Int
  blocks        Int
  elevators     Int
  hasSecurity   Boolean
  hasPool       Boolean
  hasGreenSpace Boolean
  createdAt     DateTime @default(now())
}

model SectoralSolution {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  title_en       String?
  title_ru       String?
  title_ar       String?
  description    String
  description_en String?
  description_ru String?
  description_ar String?
  icon           String
  kpiTag         String
  kpiTag_en      String?
  kpiTag_ru      String?
  kpiTag_ar      String?
  features       String // JSON string, array of strings
  features_en    String?
  features_ru    String?
  features_ar    String?
  order          Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// n8n LinkedIn Otomasyon Modelleri

model LinkedInOutreach {
  id          String    @id @default(cuid())
  targetName  String
  targetTitle String?
  firmName    String?
  linkedinUrl String
  message     String
  sentAt      DateTime  @default(now())
  accepted    Boolean?
  followupAt  DateTime?
}

model LinkedInAdSnapshot {
  id         String   @id @default(cuid())
  advertiser String
  adText     String
  keyword    String
  capturedAt DateTime @default(now())
  isNew      Boolean  @default(true)
}

model LinkedInMetrics {
  id          String   @id @default(cuid())
  weekStart   DateTime
  followers   Int
  impressions Int
  clicks      Int
  engagement  Float
  recordedAt  DateTime @default(now())
}
