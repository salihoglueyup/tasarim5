{
  "id": "w26DevOpsPgLock1",
  "name": "[DevOps & DB] W26 — PostgreSQL Kilitli / Yavaş Sorgu & Askıda Kalan Bağlantı Avcısı",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "cron-every-10min",
      "name": "Her 10 Dakikada Bir Tetikle",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  pid,\n  usename,\n  client_addr,\n  state,\n  ROUND(EXTRACT(EPOCH FROM (clock_timestamp() - state_change))::numeric, 2) as duration_seconds,\n  LEFT(query, 120) as query_preview\nFROM pg_stat_activity\nWHERE state IN ('idle in transaction', 'active')\n  AND pid <> pg_backend_pid()\nORDER BY duration_seconds DESC\nLIMIT 5;"
      },
      "id": "query-active-processes",
      "name": "Aktif & Askıdaki Sorguları Listele",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        380,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst longRunning = [];\nlet maxDuration = 0;\n\nfor (const r of rows) {\n  const data = r.json;\n  const duration = parseFloat(data.duration_seconds || 0);\n  if (duration > maxDuration) maxDuration = duration;\n  if (duration >= 30) {\n    longRunning.push({\n      pid: data.pid,\n      user: data.usename,\n      state: data.state,\n      duration,\n      query: data.query_preview\n    });\n  }\n}\n\nconst hasSlowQueries = longRunning.length > 0;\nconst summary = hasSlowQueries \n  ? `UYARI: ${longRunning.length} adet sorgu 30 saniyeden uzun süredir kilitli/askıda!` \n  : `PostgreSQL Sağlıklı: Askıda kalan veya kilitlenen sorgu yok (Maks süre: ${maxDuration}s)`;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    hasSlowQueries,\n    totalChecked: rows.length,\n    longRunningCount: longRunning.length,\n    slowQueries: longRunning,\n    maxDurationSeconds: maxDuration,\n    summary\n  }\n}];"
      },
      "id": "evaluate-query-locks",
      "name": "Kilitli Sorgu Değerlendirici",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"AuditLog\" (\"id\", \"userId\", \"action\", \"entity\", \"details\", \"createdAt\")\nVALUES (\n  $1,\n  'n8n-pg-lock-sentinel',\n  'pg_slow_queries_monitored',\n  'Database',\n  $2,\n  NOW()\n);",
        "additionalFields": {
          "queryParams": "={{ [ 'pg_lock_' + Math.random().toString(36).substr(2, 9), JSON.stringify({ slowCount: $json.longRunningCount, maxDuration: $json.maxDurationSeconds }) ] }}"
        }
      },
      "id": "log-pg-lock-db",
      "name": "AuditLog'a Yaz",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        780,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasSlowQueries }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-slow-detected",
      "name": "Yavaş/Kilitli Sorgu Var mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "bildirim@aloyonetim.com.tr",
        "toEmail": "istanbul@aloyonetim.com.tr",
        "subject": "=🛑 [POSTGRESQL KİLİT UYARISI] {{ $json.longRunningCount }} Adet Askıda Kalan Sorgu Tespit Edildi!",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 650px; margin: 0 auto; border: 1px solid #dc2626; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background: #dc2626; color: #ffffff; padding: 20px;\">\n    <h2 style=\"margin: 0; font-size: 18px;\">🛑 PostgreSQL Kilitli Sorgu & Havuz Şişmesi Alarmı</h2>\n    <p style=\"margin: 4px 0 0 0; font-size: 12px;\">Tarih: {{ $json.timestamp }} | Maks Süre: {{ $json.maxDurationSeconds }} sn</p>\n  </div>\n  <div style=\"padding: 20px; color: #1e293b;\">\n    <p style=\"font-size: 13px;\">Aşağıdaki sorgular 30 saniyeden uzun süredir veritabanı kaynaklarını bloke etmektedir:</p>\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n      <thead>\n        <tr style=\"background: #fef2f2; border-bottom: 2px solid #dc2626;\">\n          <th style=\"padding: 8px; text-align: left;\">PID</th>\n          <th style=\"padding: 8px; text-align: left;\">Durum</th>\n          <th style=\"padding: 8px; text-align: right;\">Süre (sn)</th>\n          <th style=\"padding: 8px; text-align: left;\">Sorgu</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{ $json.slowQueries.map(q => `<tr style=\"border-bottom: 1px solid #fee2e2;\"><td style=\"padding: 8px; font-weight: bold;\">${q.pid}</td><td style=\"padding: 8px;\">${q.state}</td><td style=\"padding: 8px; text-align: right; color: #dc2626; font-weight: bold;\">${q.duration}s</td><td style=\"padding: 8px; font-family: monospace; font-size: 11px;\">${q.query}</td></tr>`).join('') }}\n      </tbody>\n    </table>\n  </div>\n</div>"
      },
      "id": "send-pg-alert",
      "name": "DevOps'a Acil Kilit Bildirimi Gönder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'COMPLETED', summary: $json.summary, time: new Date().toISOString() } }];"
      },
      "id": "pg-lock-finish",
      "name": "Sonuç Özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        380
      ]
    }
  ],
