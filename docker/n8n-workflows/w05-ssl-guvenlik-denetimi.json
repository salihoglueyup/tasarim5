{
  "id": "w05DevOpsSslSec1",
  "name": "[DevOps & Güvenlik] W05 — SSL Sertifikası & Güvenlik Başlıkları Denetimi",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "schedule-security-audit",
      "name": "Pazartesi 08:00 Tetikle",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "HEAD",
        "url": "https://aloyonetim.com.tr",
        "options": {
          "timeout": 10000
        }
      },
      "id": "inspect-headers",
      "name": "HEAD https://aloyonetim.com.tr",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst hasHsts = Boolean(headers['strict-transport-security']);\nconst hasCsp = Boolean(headers['content-security-policy']);\nconst hasFrame = Boolean(headers['x-frame-options']);\nconst hasContentType = Boolean(headers['x-content-type-options']);\nconst hasReferrer = Boolean(headers['referrer-policy']);\n\nlet score = 100;\nconst missing = [];\nif (!hasHsts) { score -= 30; missing.push('HSTS (Strict-Transport-Security)'); }\nif (!hasFrame) { score -= 25; missing.push('X-Frame-Options (Clickjacking Koruması)'); }\nif (!hasContentType) { score -= 20; missing.push('X-Content-Type-Options (MIME Sniffing)'); }\nif (!hasReferrer) { score -= 15; missing.push('Referrer-Policy'); }\nif (!hasCsp) { score -= 10; missing.push('Content-Security-Policy'); }\n\nlet grade = 'A+';\nif (score < 60) grade = 'F';\nelse if (score < 75) grade = 'C';\nelse if (score < 90) grade = 'B';\nelse if (score < 95) grade = 'A';\n\nconst isDegraded = score < 80;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    score,\n    grade,\n    isDegraded,\n    hasHsts,\n    hasCsp,\n    hasFrame,\n    hasContentType,\n    hasReferrer,\n    missingHeaders: missing,\n    summary: `Güvenlik Skoru: ${grade} (%${score}) | Eksikler: ${missing.join(', ') || 'Yok (Mükemmel)'}`\n  }\n}];"
      },
      "id": "evaluate-security-headers",
      "name": "Güvenlik Skoru Analizi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isDegraded }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-security-degraded",
      "name": "Güvenlik Açığı Var mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "bildirim@aloyonetim.com.tr",
        "toEmail": "istanbul@aloyonetim.com.tr",
        "subject": "=⚠️ [GÜVENLİK UYARISI] Güvenlik Başlığı Eksikliği (Skor: {{ $json.grade }} - %{{ $json.score }})",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #ef4444; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background: #ef4444; color: #ffffff; padding: 18px;\">\n    <h2 style=\"margin: 0; font-size: 18px;\">⚠️ Güvenlik Başlığı Denetim Uyarısı</h2>\n    <p style=\"margin: 4px 0 0 0; font-size: 12px;\">Zaman: {{ $json.timestamp }}</p>\n  </div>\n  <div style=\"padding: 20px; color: #1e293b;\">\n    <p><strong>Değerlendirme Notu:</strong> {{ $json.grade }} (%{{ $json.score }})</p>\n    <p><strong>Eksik Güvenlik Başlıkları:</strong></p>\n    <ul style=\"color: #b91c1c; font-size: 13px;\">\n      {{ $json.missingHeaders.map(h => `<li>${h}</li>`).join('') }}\n    </ul>\n    <p style=\"font-size: 12px; color: #64748b;\">Lütfen <code>docker/nginx/aloyonetim.conf</code> dosyasında güvenlik başlıklarını kontrol ediniz.</p>\n  </div>\n</div>"
      },
      "id": "send-security-alert-email",
      "name": "Güvenlik Uyarısı Gönder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1000,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"AuditLog\" (\"id\", \"userId\", \"action\", \"entity\", \"details\", \"createdAt\")\nVALUES (\n  $1,\n  'n8n-sec-auditor',\n  'security_headers_audit',\n  'Security',\n  $2,\n  NOW()\n);",
        "additionalFields": {
          "queryParams": "={{ [ 'audit_sec_' + Math.random().toString(36).substr(2, 9), JSON.stringify({ score: $json.score, grade: $json.grade, summary: $json.summary }) ] }}"
        }
      },
      "id": "log-sec-audit",
      "name": "AuditLog Kaydı",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1000,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'COMPLETED', summary: $json.summary, time: new Date().toISOString() } }];"
      },
      "id": "log-sec-result",
      "name": "Sonuç Özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    }
  ],
  "connections": {
    "Pazartesi 08:00 Tetikle": {
      "main": [
        [
          {
            "node": "HEAD https://aloyonetim.com.tr",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HEAD https://aloyonetim.com.tr": {
      "main": [
        [
          {
            "node": "Güvenlik Skoru Analizi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Güvenlik Skoru Analizi": {
      "main": [
        [
          {
            "node": "Güvenlik Açığı Var mı?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Güvenlik Açığı Var mı?": {
      "main": [
        [
          {
            "node": "Güvenlik Uyarısı Gönder",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AuditLog Kaydı",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Güvenlik Uyarısı Gönder": {
      "main": [
        [
          {
            "node": "AuditLog Kaydı",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AuditLog Kaydı": {
      "main": [
        [
