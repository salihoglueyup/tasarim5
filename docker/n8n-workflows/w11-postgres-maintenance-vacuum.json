{
  "name": "W11 — PostgreSQL Otomatik Bakım & İndeks Optimizasyonu",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 0"
            }
          ]
        }
      },
      "id": "schedule-vacuum",
      "name": "Pazar 04:00 Tetikle",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "VACUUM (ANALYZE, VERBOSE);"
      },
      "id": "run-vacuum-analyze",
      "name": "VACUUM ANALYZE Çalıştır",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-cred",
          "name": "Alo Yönetim PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    timestamp: new Date().toISOString(),\n    status: 'COMPLETED',\n    summary: 'Haftalık PostgreSQL VACUUM ANALYZE bakımı başarıyla tamamlandı. Ölü satırlar temizlendi ve indeks istatistikleri güncellendi.'\n  }\n}];"
      },
      "id": "format-vacuum-log",
      "name": "Bakım Sonucunu Formatla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "console.log(`[PostgreSQL Maintenance] ${$json.timestamp}: ${$json.summary}`);\nreturn [{ json: { logged: true } }];"
      },
      "id": "log-vacuum",
      "name": "Loga Kaydet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    }
  ],
  "connections": {
    "Pazar 04:00 Tetikle": {
      "main": [
        [
          {
            "node": "VACUUM ANALYZE Çalıştır",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "VACUUM ANALYZE Çalıştır": {
      "main": [
        [
          {
            "node": "Bakım Sonucunu Formatla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bakım Sonucunu Formatla": {
      "main": [
        [
          {
            "node": "Loga Kaydet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveFailedExecutions": true
  },
  "id": "w11PgMaintVacu1"
}
