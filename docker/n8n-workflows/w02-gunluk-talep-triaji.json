{
  "id": "w02CrmDailyTrg01",
  "name": "[CRM & Operasyon] W02 — Günlük Talep Triajı & Gecikme Nöbetçisi",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,14 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Hafta İçi 09:00 ve 14:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"id\", \"type\", \"name\", \"phone\", \"email\", \"subject\", \"message\", \"meta\", \"isRead\", \"createdAt\"\nFROM \"Lead\"\nWHERE \"isRead\" = false\nORDER BY \"createdAt\" DESC\nLIMIT 50;"
      },
      "id": "fetch-pending-leads",
      "name": "PostgreSQL Bekleyen Talepleri Çek",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        420,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\n\nconst leads = items.map(item => {\n  const row = item.json;\n  let meta = {};\n  try { meta = typeof row.meta === 'string' ? JSON.parse(row.meta) : (row.meta || {}); } catch(e) {}\n  \n  const createdTime = new Date(row.createdAt).getTime();\n  const waitHours = Math.round((now - createdTime) / (1000 * 60 * 60));\n  \n  return {\n    id: row.id,\n    name: row.name || 'İsimsiz',\n    phone: row.phone || 'Belirtilmedi',\n    email: row.email || '-',\n    type: row.type || 'quote',\n    district: meta.district || 'İstanbul',\n    segment: meta.segment || 'STANDART',\n    priority: meta.priority || (waitHours > 2 ? 'YUKSEK' : 'STANDART'),\n    waitHours,\n    createdAt: new Date(row.createdAt).toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' })\n  };\n});\n\nconst vipCount = leads.filter(l => l.priority === 'ACIL_VIP' || l.segment === 'VIP_REZIDANS').length;\nconst overdueCount = leads.filter(l => l.waitHours >= 2).length;\n\nreturn [{\n  json: {\n    totalPending: leads.length,\n    vipCount,\n    overdueCount,\n    hasLeads: leads.length > 0,\n    leads,\n    reportTime: new Date().toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' })\n  }\n}];"
      },
      "id": "analyze-leads",
      "name": "Bekleme Süresi & Öncelik Analizi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasLeads }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-has-leads",
      "name": "Bekleyen Talep Var mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "bildirim@aloyonetim.com.tr",
        "toEmail": "istanbul@aloyonetim.com.tr",
        "subject": "=📊 Günlük Müşteri Talepleri Triajı: {{ $json.totalPending }} Bekleyen Talep ({{ $json.vipCount }} VIP, {{ $json.overdueCount }} Gecikmiş)",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 680px; margin: 0 auto; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background: #0f172a; color: #ffffff; padding: 20px;\">\n    <h2 style=\"margin: 0; font-size: 18px;\">📋 Alo Yönetim — Günlük Müşteri Talepleri Triaj Raporu</h2>\n    <p style=\"margin: 4px 0 0 0; font-size: 12px; color: #94a3b8;\">Rapor Tarihi: {{ $json.reportTime }}</p>\n  </div>\n  <div style=\"padding: 20px;\">\n    <div style=\"display: flex; gap: 10px; margin-bottom: 20px;\">\n      <div style=\"flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 6px; text-align: center;\">\n        <div style=\"font-size: 20px; font-weight: bold; color: #0284c7;\">{{ $json.totalPending }}</div>\n        <div style=\"font-size: 11px; color: #64748b;\">Toplam Bekleyen</div>\n      </div>\n      <div style=\"flex: 1; background: #fef2f2; border: 1px solid #fee2e2; padding: 12px; border-radius: 6px; text-align: center;\">\n        <div style=\"font-size: 20px; font-weight: bold; color: #dc2626;\">{{ $json.vipCount }}</div>\n        <div style=\"font-size: 11px; color: #991b1b;\">VIP Rezidans</div>\n      </div>\n      <div style=\"flex: 1; background: #fffbeb; border: 1px solid #fef3c7; padding: 12px; border-radius: 6px; text-align: center;\">\n        <div style=\"font-size: 20px; font-weight: bold; color: #d97706;\">{{ $json.overdueCount }}</div>\n        <div style=\"font-size: 11px; color: #92400e;\">2+ Saat Bekleyen</div>\n      </div>\n    </div>\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n      <thead>\n        <tr style=\"background: #f1f5f9; border-bottom: 2px solid #cbd5e1;\">\n          <th style=\"padding: 8px; text-align: left;\">Müşteri</th>\n          <th style=\"padding: 8px; text-align: left;\">Telefon</th>\n          <th style=\"padding: 8px; text-align: left;\">İlçe</th>\n          <th style=\"padding: 8px; text-align: left;\">Öncelik</th>\n          <th style=\"padding: 8px; text-align: center;\">Bekleme</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{ $json.leads.map(l => `<tr style=\"border-bottom: 1px solid #e2e8f0;\"><td style=\"padding: 8px; font-weight: bold;\">${l.name}</td><td style=\"padding: 8px;\"><a href=\"tel:${l.phone}\" style=\"color:#0284c7;text-decoration:none;\">${l.phone}</a></td><td style=\"padding: 8px;\">${l.district}</td><td style=\"padding: 8px;\">${l.priority}</td><td style=\"padding: 8px; text-align: center; color: ${l.waitHours >= 2 ? '#dc2626' : '#16a34a'}; font-weight: bold;\">${l.waitHours} saat</td></tr>`).join('') }}\n      </tbody>\n    </table>\n  </div>\n</div>"
      },
      "id": "send-digest-email",
      "name": "Operasyon Brifingi E-Postası",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"AuditLog\" (\"id\", \"userId\", \"action\", \"entity\", \"details\", \"createdAt\")\nVALUES (\n  $1,\n  'n8n-crm-triage',\n  'daily_lead_digest_sent',\n  'Lead',\n  $2,\n  NOW()\n);",
        "additionalFields": {
          "queryParams": "={{ [ 'audit_crm_' + Math.random().toString(36).substr(2, 9), JSON.stringify({ totalPending: $json.totalPending, vipCount: $json.vipCount, overdueCount: $json.overdueCount }) ] }}"
        }
      },
      "id": "log-audit-entry",
      "name": "AuditLog Kaydı",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1100,
        420
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'OK', totalProcessed: $json.totalPending || 0, time: new Date().toISOString() } }];"
      },
      "id": "summary-log",
      "name": "Sonuç Özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    }
  ],
