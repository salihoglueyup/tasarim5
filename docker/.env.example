# docker/.env.example — ŞABLON (git'e commit'lenir, gerçek secret İÇERMEZ).
# Kurulum: bu dosyayı `docker/.env` olarak kopyalayıp değerleri doldurun.
#   cp docker/.env.example docker/.env
# docker compose, docker/.env dosyasını otomatik okur.
#
# Üretimde güçlü rastgele değerler üretin, örn:
#   openssl rand -base64 32

# Postgres veritabanı parolası. NOT: mevcut ./data/postgres volume'u varsa,
# o volume'un ilk init edildiği parolayla aynı olmalıdır (Postgres parolayı
# yalnız ilk kurulumda ayarlar). Yeni ortamda güçlü bir değer seçin.
POSTGRES_PASSWORD=change_me_strong_postgres_password

# JWT imzalama anahtarı (admin oturum token'ları). 32+ bayt rastgele olmalı.
# Zayıf/tahmin edilebilir değer => token sahteciliği (session hijacking).
JWT_SECRET=change_me_openssl_rand_base64_32

# Redis parolası (requirepass). Auth'suz Redis dış ağdan okunabilir.
REDIS_PASSWORD=change_me_strong_redis_password
