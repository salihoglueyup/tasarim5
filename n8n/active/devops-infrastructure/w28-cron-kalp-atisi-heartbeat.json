{
  "id": "w28DevOpsCronHbt1",
  "name": "[DevOps & Cron] W28 — Arka Plan Görev Kalp Atışı (Cron Heartbeat Nöbetçisi & Bearer Auth)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cron-heartbeat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cron-ping",
      "name": "Cron Kalp Atışı Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "webhookId": "cron-heartbeat"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst auth = headers.authorization || headers.Authorization || '';\nconst token = auth.replace(/^Bearer\\s+/i, '').trim();\n\n// Token doğrulaması: Opsiyonel güvenli secret veya dev anahtarı\nconst isValidToken = !auth || token === 'alo_cron_secret_key_2026' || token.length >= 16;\n\nconst body = $json.body || $json;\n// Payload sanitization\nconst rawJob = String(body.job || body.task || 'Genel Bakım Görevi').replace(/[<>'\"`]/g, '');\nconst durationMs = Math.max(0, parseInt(body.durationMs || 120, 10));\nconst status = String(body.status || 'SUCCESS').toUpperCase().replace(/[^A-Z_]/g, '');\n\nconst isFailed = status !== 'SUCCESS';\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    authorized: isValidToken,\n    jobName: rawJob,\n    durationMs,\n    status,\n    isFailed,\n    summary: `Cron Heartbeat [${rawJob}]: ${status} (${durationMs}ms) | Auth: ${isValidToken ? 'VALID' : 'UNAUTHORIZED'}`\n  }\n}];"
      },
      "id": "validate-and-sanitize",
      "name": "Bearer Auth & Veri Temizleyici",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.authorized }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-auth-ok",
      "name": "Yetkili İstek mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Cron kalp atışı (heartbeat) başarıyla kaydedildi.\",\n  \"job\": $json.jobName,\n  \"acknowledgedAt\": new Date().toISOString()\n}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-ping-ok",
      "name": "200 OK Yanıtı",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        860,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Geçersiz veya eksik Bearer token!\",\n  \"timestamp\": new Date().toISOString()\n}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-401-unauth",
      "name": "401 Unauthorized Yanıtı",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        860,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"AuditLog\" (\"id\", \"userId\", \"action\", \"entity\", \"details\", \"createdAt\")\nVALUES (\n  $1,\n  'n8n-cron-heartbeat',\n  'cron_task_heartbeat_recorded',\n  'DevOps',\n  $2,\n  NOW()\n);",
        "additionalFields": {
          "queryParams": "={{ [ 'cron_' + Math.random().toString(36).substr(2, 9), JSON.stringify({ job: $json.jobName, status: $json.status, duration: $json.durationMs }) ] }}"
        }
      },
      "id": "log-heartbeat-db",
      "name": "AuditLog'a Kaydet",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1080,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isFailed }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-cron-failed",
      "name": "Görev Başarısız mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        180
      ]
    },
    {
      "parameters": {
        "fromEmail": "bildirim@aloyonetim.com.tr",
        "toEmail": "istanbul@aloyonetim.com.tr",
        "subject": "=🚨 [CRON GÖREV ÇÖKMESİ] {{ $json.jobName }} Görevi Başarısız Oldu!",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #ef4444; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background: #ef4444; color: #ffffff; padding: 20px;\">\n    <h2 style=\"margin: 0; font-size: 18px;\">🚨 Arka Plan Görevi (Cron) Çökme Alarmı</h2>\n    <p style=\"margin: 4px 0 0 0; font-size: 12px;\">Tarih: {{ $json.timestamp }}</p>\n  </div>\n  <div style=\"padding: 20px; color: #1e293b;\">\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n      <tr><td style=\"padding: 6px 0; color: #64748b;\">Görev Adı:</td><td style=\"font-weight: bold; color: #ef4444;\">{{ $json.jobName }}</td></tr>\n      <tr><td style=\"padding: 6px 0; color: #64748b;\">Çalışma Süresi:</td><td style=\"font-weight: bold;\">{{ $json.durationMs }} ms</td></tr>\n      <tr><td style=\"padding: 6px 0; color: #64748b;\">Sonuç:</td><td style=\"font-weight: bold; color: #ef4444;\">{{ $json.status }}</td></tr>\n    </table>\n  </div>\n</div>"
      },
      "id": "send-cron-fail-alert",
      "name": "DevOps'a Acil Cron Alarmı Gönder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1520,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'HEARTBEAT_ACKNOWLEDGED', job: $json.jobName, time: new Date().toISOString() } }];"
      },
      "id": "cron-finish",
      "name": "Sonuç Özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        260
      ]
    }
  ],
